{
  "name": "fattixx-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Fat Tixx admin console for platform staff (Super Admin, Support, Finance). Shares src/lib, src/components and node_modules with the public site in ../Fattixx-web; only the routes live here.",
  "scripts": {
    "dev": "node ../Fattixx-web/node_modules/next/dist/bin/next dev -p 3100",
    "build": "node ../Fattixx-web/node_modules/next/dist/bin/next build",
    "start": "node ../Fattixx-web/node_modules/next/dist/bin/next start -p 3100",
    "lint": "node ../Fattixx-web/node_modules/eslint/bin/eslint.js",
    "typecheck": "node ../Fattixx-web/node_modules/next/dist/bin/next typegen && node ../Fattixx-web/node_modules/typescript/bin/tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "next": "16.3.7",
    "typescript": "7.0.2"
  }
}
