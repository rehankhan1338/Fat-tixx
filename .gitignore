# Repository-wide ignores. Each app keeps its own .gitignore too:
#   Fattixx-web/    public site + shared code (Next.js)
#   Fattixx-admin/  admin console (Next.js, shares Fattixx-web's code and node_modules)
#   Fattixx-app/    mobile app (Expo)

# dependencies (the root node_modules is a link to Fattixx-web/node_modules, made by its postinstall, for Fattixx-admin)
node_modules/

# env files (each app's .env.example is kept)
.env*
!.env.example

# next.js build output and generated files
.next/
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# misc
.DS_Store
*.pem

# Expo mobile app (Fattixx-app has its own .gitignore for .expo and builds)
Fattixx-app/*.keystore
