# Copy of the variables `npm run db:setup` writes to .env.local (which is git-ignored).
# You normally do not need to edit anything: run `npm run db:setup` and it fills .env.local.

# MariaDB / MySQL (XAMPP default is port 3306; this machine's XAMPP uses 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=fattixx
DB_USER=fattixx_app
DB_PASSWORD=<generated by db:setup>

# Admin credentials used ONLY by `npm run db:setup` to create the database, user and tables.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# Public origin for links in emails, SMS and embed snippets. Leave as-is for local dev; on Vercel it is
# derived automatically from the production domain, so only set it there to force a specific host.
APP_URL=http://localhost:3000

# Origin of the admin console (the separate app in Fattixx-admin/, `npm run admin:dev`), where platform staff
# sign in. Both servers read this file; set it to the console's domain in production.
ADMIN_URL=http://localhost:3100

# Set to true ONLY when running behind a reverse proxy you control (nginx, Cloudflare, Vercel).
# When true, the client IP is read from X-Forwarded-For for rate limiting and audit logs.
TRUST_PROXY=false

# HMAC-SHA256 key that signs ticket QR codes. Generated by db:setup. Rotating it invalidates every issued QR code.
TICKET_SIGNING_KEY=<generated by db:setup>

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys). Without them only free/complimentary orders work.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Outgoing email via Brevo. The normal place to configure this is Admin -> Settings -> Integrations (the key is stored
# encrypted in the database and shared by the public site and the admin console); these variables are only a fallback
# when nothing is saved there. MAIL_FROM must be a sender verified in Brevo. SMTP_URL is only used when there is no
# Brevo key. Without either, every message is only recorded in Admin -> Emails.
BREVO_API_KEY=
SMTP_URL=
MAIL_FROM="Fattixx <tickets@fattixx.com>"

# "Continue with Google" in the sign-up window at the end of /create (optional; the button is hidden without them).
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URI: <APP_URL>/api/auth/google/callback  (e.g. http://localhost:3000/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Venue address suggestions, map position and time zone on /create (optional). Enable "Places API (New)" and
# "Time Zone API" for the key; it is used on the server only, so restrict it by API (not by HTTP referrer).
# Without it, suggestions come from OpenStreetMap (photon.komoot.io, fair use) and the time zone from a built-in table.
GOOGLE_MAPS_API_KEY=

# SMS ticket links, reminders and the sign-up codes for "Continue with phone" (optional). Without these, texts are only
# logged under Admin -> Emails (in development the sign-up code is then shown on screen).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Background jobs run every minute inside the server. When an external scheduler calls GET /api/cron instead,
# set JOBS_DISABLED=true and give it this bearer token.
CRON_SECRET=
JOBS_DISABLED=false

# Uploaded images (event covers, logos, ads, site photos). On Vercel the filesystem is read-only, so uploads go to a
# Vercel Blob store: create one under the project's Storage tab and connect it; Vercel then sets this variable itself.
# Locally you can leave it empty (files are written to ./uploads) or paste the store's token to upload to Blob from dev too.
BLOB_READ_WRITE_TOKEN=

# Fattixx Pro custom domains (src/lib/pro/domains.ts). Requests to any host that is not Fattixx's own (APP_URL, ADMIN_URL,
# *.vercel.app, PLATFORM_HOSTS) are treated as an organizer's domain. Off under `next dev` unless CUSTOM_DOMAINS=on;
# CUSTOM_DOMAINS=off disables them everywhere. PLATFORM_HOSTS: extra Fattixx hosts, comma separated (e.g. a tunnel).
CUSTOM_DOMAINS=
PLATFORM_HOSTS=
# On Vercel: a token and the project id let Fattixx add verified domains to the project, so Vercel issues the
# certificate automatically. Without them, add domains in Vercel by hand, or self-host with on-demand TLS asking
# GET /api/domains/allowed. The DNS targets shown to organizers default to Vercel's.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
CUSTOM_DOMAIN_CNAME=cname.vercel-dns.com
CUSTOM_DOMAIN_A=76.76.21.21

# Fattixx Pro email campaigns: emails sent per background-job run (every minute). Keep within your Brevo plan's rate.
MARKETING_BATCH=100

# CAPTCHA on checkout, account sign-up, sign-in codes and organizer applications (src/lib/security/captcha.ts): Cloudflare
# Turnstile, on top of the built-in honeypot, fill-time check and rate limits. Cloudflare dashboard -> Turnstile -> Add
# site (widget mode "Managed"). On only when both are set. The site key is built into the pages, so redeploy after changing it.
# Test keys that always pass: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# "Add to Apple Wallet" on the ticket page (src/lib/wallet/apple.ts). Apple Developer account -> Certificates, Identifiers &
# Profiles: create a Pass Type ID and its certificate; export the certificate and key as PEM. WWDR = Apple's Worldwide
# Developer Relations intermediate (G4). PEM values may be pasted with literal \n or as base64 of the PEM. Hidden until set.
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_CERT=
APPLE_WALLET_KEY=
APPLE_WALLET_KEY_PASSPHRASE=
APPLE_WALLET_WWDR=

# "Add to Google Wallet" on the ticket page (src/lib/wallet/google.ts). Google Pay & Wallet Console -> Google Wallet API:
# the issuer ID; Google Cloud: enable the Google Wallet API, create a service account, add it as a user of the issuer, and
# paste its JSON key (raw JSON or base64). Until Google approves the issuer, only its test accounts can save passes.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT=
