# Copy of the variables `npm run db:setup` writes to .env.local (which is git-ignored).
# You normally do not need to edit anything: run `npm run db:setup` and it fills .env.local.

# MariaDB / MySQL (XAMPP default is port 3306; this machine's XAMPP uses 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=fattixx
DB_USER=fattixx_app
DB_PASSWORD=<generated by db:setup>

# Admin credentials used ONLY by `npm run db:setup` to create the database, user and tables.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# Public origin for links in emails, SMS and embed snippets. Leave as-is for local dev; on Vercel it is
# derived automatically from the production domain, so only set it there to force a specific host.
APP_URL=http://localhost:3000

# Set to true ONLY when running behind a reverse proxy you control (nginx, Cloudflare, Vercel).
# When true, the client IP is read from X-Forwarded-For for rate limiting and audit logs.
TRUST_PROXY=false

# HMAC-SHA256 key that signs ticket QR codes. Generated by db:setup. Rotating it invalidates every issued QR code.
TICKET_SIGNING_KEY=<generated by db:setup>

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys). Without them only free/complimentary orders work.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Outgoing email. Without SMTP_URL every message is only recorded in Admin -> Emails.
SMTP_URL=
MAIL_FROM="Fat Tixx <tickets@fattixx.com>"

# SMS ticket links and reminders (optional). Without these, texts are only logged under Admin -> Emails.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Background jobs run every minute inside the server. When an external scheduler calls GET /api/cron instead,
# set JOBS_DISABLED=true and give it this bearer token.
CRON_SECRET=
JOBS_DISABLED=false

# Uploaded images (event covers, logos, ads, site photos). On Vercel the filesystem is read-only, so uploads go to a
# Vercel Blob store: create one under the project's Storage tab and connect it; Vercel then sets this variable itself.
# Locally you can leave it empty (files are written to ./uploads) or paste the store's token to upload to Blob from dev too.
BLOB_READ_WRITE_TOKEN=
