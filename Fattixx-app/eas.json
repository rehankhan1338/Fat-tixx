{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "lan": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.0.231:3000",
        "EXPO_PUBLIC_ALLOW_HTTP_API": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://fat-tixx.vercel.app"
      }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "ios": { "autoIncrement": true },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://fat-tixx.vercel.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "6834284490" }
    }
  }
}
