# Copy to `.env` (git-ignored). Everything here is optional in development.
#
# Testing with Expo Go: leave EXPO_PUBLIC_API_URL unset. The app talks to the PC that runs `npx expo start`
# (the same address it loaded the bundle from) on the port below, so it works on any Wi-Fi without edits.
# Start the website first with `npm run dev` in ../Fattixx-web; phone and PC must be on the same Wi-Fi.
# EXPO_PUBLIC_API_PORT=3000

# Fixed backend instead: a tunnel, a staging server, or release builds (which require https).
# EXPO_PUBLIC_API_URL=https://fattixx.com
