# Copy to `.env` (git-ignored). Where the Fat Tixx backend (the Next.js site) runs.
#
# Testing on a phone with Expo Go: use your PC's LAN IP, same Wi-Fi, with `npm run dev` running in the
# website folder (its next.config already allows 192.168.1.22; add your IP to `allowedDevOrigins` if different).
EXPO_PUBLIC_API_URL=http://192.168.1.22:3000

# Production builds (EAS): must be https, e.g. https://fattixx.com
# EXPO_PUBLIC_API_URL=https://fattixx.com
